<!DOCTYPE html>
<html>
   <% 
     function score(position) {
     let score = 0 
       if(position < 76) {
          score = Math.round(100*(50.0 / (Math.pow(Math.E, 0.001 * position)) * Math.log((1 / (0.008 * position)))))/100
      } else if(position > 75 && position < 101) {
          score = Math.round(100*(50.0 / (Math.pow(Math.E, 0.01 * position)) * Math.log((210 / Math.pow(position, 1.001)))))/100
      } else if(position > 100 && position < 151) {
          score = Math.round(100*(50.0 / (Math.pow(Math.E, 0.01 * position)) * Math.log((3.3 / Math.pow(position, .1)))))/100
      } else {
         score = 0// Math.round(100*(50.0 / (Math.pow(Math.E, 0.01 * position)) * Math.log((3.3 / (Math.pow(position, .1))))))/100;
      }
        return score
        }
          %>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta property="og:title" content="Geometry Dash LRR Demonlist">
    <meta property="og:description" content="A demon list dedicated to low-refresh-rate (60hz, 75hz, Mobile) Geometry Dash players.">
    <meta name="author" content="ryan9328">
    <meta name="keywords" content="ryan9328,official,geometry,dash,hardest,extreme,insane,demon,list,demonlist,hardest,levels,gmd,gd,typier,game,top,level,levels,player,players,geometry dash, LRR, 60hz, 60HZ, 75hz, 75HZ, geometry dash 60hz demonlist, GD 60hz list">
    <meta name="description" content="A demon list dedicated to low-refresh-rate (60hz, 75hz, Mobile) Geometry Dash players.">
    <title>GD LRR Demon List</title>
  <link href="CSS/levelcards.css?v=2022-03-30" rel="stylesheet" type="text/css" />
  <link href="CSS/leaderboard.css?v=2021-11-15" rel="stylesheet" type="text/css" />
    <link href="CSS/nav.css?v=2021-07-30" rel="stylesheet" type="text/css" />
    <link href="CSS/list.css?v=2020-10-29" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Bitter|Bitter:light,bold">
    <link rel="shortcut icon" type="image/x-icon" href="favicon.ico" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://kit.fontawesome.com/b65d578950.js" crossorigin="anonymous"></script>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <script>
      function decodeHTMLEntities(text) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(text, 'text/html');
      return doc.documentElement.textContent;
  }
  let editingLevel = {}
  let deletingLevel = {}
  let addingLevel = {
    completion: {}}

  let originalLevels = JSON.parse(decodeHTMLEntities("<%= JSON.stringify(levels) %>"))
        let filteredLevels = JSON.parse(decodeHTMLEntities("<%= JSON.stringify(levels) %>"))
        let edits = []
        var type = "levels"
    function topFunction() {
  document.body.scrollTop = 0;
  document.documentElement.scrollTop = 0;
  }
    function deep(smt) {
      let visibility = document.getElementById(smt).style.visibility
        if(visibility == "hidden") {
  document.getElementById(smt).style.visibility = "visible"
  document.getElementById(smt).style.height = "20px"
    } else {
    document.getElementById(smt).style.visibility = "hidden"
          document.getElementById(smt).style.height = "0px"
    }
              }
  
              function allowDrop(ev) {
        ev.preventDefault();
      }

      function cancel() {
        filteredLevels = structuredClone(originalLevels)
        edits = []
        renderLevels(originalLevels)
        document.getElementById("save").disabled = true
        document.getElementById("add").disabled = false
        document.getElementById("cancel").disabled = true
      }

      async function save() {
        document.getElementById("update-text").innerText = "Updating..."
        let response = await fetch(`https://test.gdlrrlist.com/api/helper/levels/position${type == "levels" ? "" : "/61hertz"}`, {
      method: "PATCH",
      body: JSON.stringify(edits),
      headers: {
        'content-type': 'application/json',
        'authorization': `Helper ${getCookie("token")}`
      }
    })
    if(response.ok) {
        document.getElementById("update-text").innerText = "Refreshing..."
      let req = await fetch(`https://test.gdlrrlist.com/api/v1/demons${type == "levels" ? "" : "/61hertz"}`)
      originalLevels = await req.json()
      cancel()
      document.getElementById("update-text").innerText = "Success!"
      setTimeout(() => {
      document.getElementById("update-text").innerText = ""
      }, 3000)
    } else {
      document.getElementById("update-text").innerText = "Something went wrong. Check the console"
    }
  }

  async function switchLevs() {
    if(type == "61hertz") {
      let req = await fetch("https://test.gdlrrlist.com/api/v1/demons")
      originalLevels = await req.json()
      cancel()
    } else if(type == "levels") {
      let req = await fetch("https://test.gdlrrlist.com/api/v1/demons/61hertz")
      originalLevels = await req.json()
      cancel()
    }
    type = type == "levels" ? "61hertz" : "levels"
    document.getElementById("switch").innerText = `Switch to ${type == "levels" ? "61hertz" : "levels"}`
  }

  async function add() {
        let swal = await Swal.fire({
          title: "Adding Level",
          showDenyButton: true,
          confirmButtonColor: "#3085d6",
        denyButtonColor: "red",
        confirmButtonText: "Save",
        denyButtonText: "Cancel",
        html: `<div>
          <div style="display: flex; gap: 10px; align-items: center;">
                <p>Position:</p>
                <input type="number" style="height: fit-content;" onchange="addEntry(parseInt(event.target.value), 'position')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>Name:</p>
                <input type="text" style="height: fit-content;" onchange="addEntry(event.target.value, 'name')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>Publisher:</p>
                <input type="text" style="height: fit-content;" onchange="addEntry(event.target.value, 'publisher')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>YT Code:</p>
                <input type="text" style="height: fit-content;" onchange="addEntry(event.target.value, 'ytcode')"/>
            </div>
           ${type == "levels" ? `<div style="display: flex; gap: 10px; align-items: center;">
                <p>minimumPercent?:</p>
                <input type="number" style="height: fit-content;" onchange="addEntry(parseInt(event.target.value), 'minimumPercent')"/>
            </div>` : ``}
            <br><h3>Completion</h3><br>
              <div style="display: flex; gap: 10px; align-items: center;">
                <p>Name:</p>
                <input style="height: fit-content;" onchange="addEntry(event.target.value, 'completion', 'name')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>Link:</p>
                <input style="height: fit-content;" onchange="addEntry(event.target.value, 'completion', 'link')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>Hertz:</p>
                <input style="height: fit-content;" onchange="addEntry(event.target.value, 'completion', 'hertz')"/>
            </div>
          </div>`
        })
        if(swal.isConfirmed) {
          document.getElementById("update-text").innerText = "Updating..."
        let response = await fetch(`https://test.gdlrrlist.com/api/mods/levels${type == "levels" ? "" : "/61hertz"}`, {
      method: "POST",
      body: JSON.stringify(addingLevel),
      headers: {
        'content-type': 'application/json',
        'authorization': `Moderator ${getCookie("token")}`
      }
    })
    if(response.ok) {
        document.getElementById("update-text").innerText = "Refreshing..."
      let req = await fetch(`https://test.gdlrrlist.com/api/v1/demons${type == "levels" ? "" : "/61hertz"}`)
      originalLevels = await req.json()
      cancel()
      document.getElementById("update-text").innerText = "Success!"
      setTimeout(() => {
      document.getElementById("update-text").innerText = ""
      }, 3000)
    } else {
      document.getElementById("update-text").innerText = "Something went wrong. Check the console"
    }
        }
        addingLevel = {
          completion: {}}
      }
  
      function renderLevels(levels) {
        let children = []
        for(let i = 0; i < levels.length; i++) {
          let div = document.createElement("div")
          div.className = "card"
          div.style = "border: 1px solid black; width:200px"
          div.draggable = true
          div.ondragstart = drag
          div.ondragover = allowDrop
          div.ondrop = drop
          div.onclick = () => {
            popup(i)
          }
          div.id = levels[i]._id.toString()
          div.innerHTML = `<p>${levels[i].position}. ${levels[i].name} by ${levels[i].publisher}${!levels[i].difference ? "" : levels[i].difference > 0 ? `&nbsp;<span style='color: green;'>+${levels[i].difference}</span>` : `&nbsp;<span style='color: red;'>${levels[i].difference}</span>`}</p>`
          children.push(div)
        }
        document.getElementById("levels").replaceChildren(...children)
      }
      
      function drag(ev) {
        ev.dataTransfer.setData("pos", ev.target.id);
      }
      
      function drop(ev) {
        ev.preventDefault();
        let levPos = parseInt(filteredLevels.find(e => e._id.toString() == ev.dataTransfer.getData("pos"))?.position);
        let newLevPos = parseInt(filteredLevels.find(e => e._id.toString() == ev.currentTarget.id)?.position)
        let levels = structuredClone(filteredLevels)
        edits.push({
            id: ev.dataTransfer.getData("pos"),
            position: newLevPos
        })
        levels.filter(e => e.difference).map(x => {
            if(x.position >= newLevPos && levPos > x.position) {
                x.difference--
            }
            if(x.position < newLevPos && levPos < x.position) {
                x.difference++
            }
            return x
        })
        for(let i = Math.min(levPos, newLevPos)-1; i < Math.max(levPos, newLevPos); i++) {
            if(i == levPos-1) {
                levels[i].difference = originalLevels.find(x => x._id.toString() == levels[i]._id.toString())?.position - newLevPos
                levels[i].position = newLevPos
                continue;
            }
            if(levPos > newLevPos) {
                levels[i].position += 1
                continue;
            }
            if(levPos < newLevPos) {
                levels[i].position -= 1
                continue;
            }
        }
        levels.sort((a,b) => a.position - b.position)
        filteredLevels = structuredClone(levels)
        document.getElementById("save").disabled = false
        document.getElementById("add").disabled = true
        document.getElementById("cancel").disabled = false
        renderLevels(filteredLevels)
      }

      function addEntry(value, ...args) {
        let depth = `["${args.join('"]["')}"]`
        eval(`addingLevel${depth} = ${JSON.stringify(value)}`)
      }

      function editEntry(value, ...args) {
        let depth = `["${args.join('"]["')}"]`
        eval(`editingLevel${depth} = ${JSON.stringify(value)}`)
      }

      function deleteEntry(value, ...args) {
        let depth = `["${args.join('"]["')}"]`
        eval(`deletingLevel${depth} = ${JSON.stringify(value)}`)
      }

      function deleteRecord(id, type) {
        let record = editingLevel[type].findIndex(e => e.name == id)
        editingLevel[type].splice(record, 1)
        renderListSelection(false, type)
        renderRecords("", type)
      }

      function renderRecords(id, type) {
          let record = editingLevel[type].find(e => e.name == id)
          let ind = editingLevel[type].findIndex(e => e.name == id)
          if(!record) {
            document.getElementById(type == "list" ? "record" : "progress").innerHTML = ""
          }
          document.getElementById(type == "list" ? "record" : "progress").innerHTML = `<div style="display: grid; place-items: center"><button style="background-color: red; color:white; padding: 10px; border-radius: 5px;" onclick="deleteRecord('${id}', '${type}')">Delete</button></div>
          <div style="display: flex; gap: 10px; align-items: center;">
                <p>Name:</p>
                <input type="text" value="${record.name}" style="height: fit-content;" onchange="editEntry(event.target.value, '${type}', ${ind}, 'name')"/>
            </div><div style="display: flex; gap: 10px; align-items: center;">
                <p>Link:</p>
                <input type="text" value="${record.link}" style="height: fit-content;" onchange="editEntry(event.target.value, '${type}', ${ind}, 'link')"/>
            </div><div style="display: flex; gap: 10px; align-items: center;">
                <p>Hertz:</p>
                <input type="text" value="${record.hertz}" style="height: fit-content;" onchange="editEntry(event.target.value, '${type}', ${ind}, 'hertz')"/>
            </div>
          ${type == "progresses" ? `<div style="display: flex; gap: 10px; align-items: center;">
                <p>Percent:</p>
                <input type="number" value="${record.percent}" style="height: fit-content;" onchange="editEntry(parseInt(event.target.value), '${type}', ${ind}, 'percent')"/>
            </div>` : ""}`
        }

        function renderListSelection(shouldReturn, type) {
          if(shouldReturn) {
            return `<select onchange="renderRecords(event.target.value, '${type}')">
                  <option>Select a record</option>
                  ${editingLevel[type].map(x => `<option value="${x.name}">${x.name}</option>`).join("")}
                </select>`
          } else {
            document.getElementById(`${type}-selection`).innerHTML = `<select onchange="renderRecords(event.target.value, '${type}')">
                  <option>Select a record</option>
                  ${editingLevel[type].map(x => `<option value="${x.name}">${x.name}</option>`).join("")}
                </select>`
          }
        }

      async function popup(index = 0) {
        let {position} = originalLevels.find(e => filteredLevels[index]._id == e._id)
        let req = await fetch(`https://test.gdlrrlist.com/api/v1/demons/${type == "levels" ? "" : "61hertz/"}${position}`)
        let json = await req.json()
        json.progresses = json.progresses.filter(e => typeof e !== 'string')
        editingLevel = structuredClone(json)
        let swal = await Swal.fire({
          title: "Level Editor",
          showCancelButton: true,
          showDenyButton: true,
          confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        denyButtonColor: "red",
        confirmButtonText: "Save",
        denyButtonText: "Cancel",
        cancelButtonText: "Delete",
        html: `<div>
          <div style="display: flex; gap: 10px; align-items: center;">
                <p>Position:</p>
                <input type="number" value="${filteredLevels[index].position}" style="height: fit-content;" onchange="editEntry(parseInt(event.target.value), 'position')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>Name:</p>
                <input type="text" value="${filteredLevels[index].name}" style="height: fit-content;" onchange="editEntry(event.target.value, 'name')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>Publisher:</p>
                <input type="text" value="${filteredLevels[index].publisher}" style="height: fit-content;" onchange="editEntry(event.target.value, 'publisher')"/>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>YT Code:</p>
                <input type="text" value="${filteredLevels[index].ytcode}" style="height: fit-content;" onchange="editEntry(event.target.value, 'ytcode')"/>
            </div>
            ${index > 74 ? "" : `<div style="display: flex; gap: 10px; align-items: center;">
                <p>minimumPercent:</p>
                <input type="number" value="${json.minimumPercent}" style="height: fit-content;" onchange="editEntry(parseInt(event.target.value), 'minimumPercent')"/>
            </div>`}
            <div style="display: flex; gap: 10px; align-items: center;">
                <p>List:</p>
                <div id="list-selection">
            ${renderListSelection(true, "list")}
            </div>
            </div>
            <div style="margin-left: 20px" id="record">
                
            </div>
          ${index > 74 ? "" : `<div style="display: flex; gap: 10px; align-items: center;">
                <p>Progresses:</p>
                <div id="progresses-selection">
            ${renderListSelection(true, "progresses")}
            </div>
            </div>
            <div style="margin-left: 20px" id="progress">
                
            </div>`}
          </div>`
        })
        if(swal.isConfirmed) {
          document.getElementById("update-text").innerText = "Updating..."
        let response = await fetch(`https://test.gdlrrlist.com/api/helper/levels${type == "levels" ? "" : "/61hertz"}`, {
      method: "PATCH",
      body: JSON.stringify(editingLevel),
      headers: {
        'content-type': 'application/json',
        'authorization': `Helper ${getCookie("token")}`
      }
    })
    if(response.ok) {
        document.getElementById("update-text").innerText = "Refreshing..."
      let req = await fetch(`https://test.gdlrrlist.com/api/v1/demons${type == "levels" ? "" : "/61hertz"}`)
      originalLevels = await req.json()
      cancel()
      document.getElementById("update-text").innerText = "Success!"
      setTimeout(() => {
      document.getElementById("update-text").innerText = ""
      }, 3000)
    } else {
      document.getElementById("update-text").innerText = "Something went wrong. Check the console"
    }
        }
        console.log(swal)
        if(swal.dismiss == "cancel") {
          deletingLevel._id = editingLevel._id.toString()
          deletingLevel.reason = ""
          let swal2 = await Swal.fire({
          title: "Delete Level",
          showDenyButton: true,
          confirmButtonColor: "#3085d6",
        denyButtonColor: "red",
        confirmButtonText: "Continue",
        denyButtonText: "Cancel",
        html: `<div style="display: flex; gap: 10px; align-items: center;">
                <p>Reason?:</p>
                <input style="height: fit-content;" onchange="deleteEntry(event.target.value, 'reason')"/>
            </div>`
          })
          if(swal2.isConfirmed) {
            document.getElementById("update-text").innerText = "Updating..."
        let response = await fetch(`https://test.gdlrrlist.com/api/mods/levels${type == "levels" ? "" : "/61hertz"}`, {
      method: "DELETE",
      body: JSON.stringify(deletingLevel),
      headers: {
        'content-type': 'application/json',
        'authorization': `Moderator ${getCookie("token")}`
      }
    })
        document.getElementById("update-text").innerText = "Refreshing..."
      let req = await fetch(`https://test.gdlrrlist.com/api/v1/demons${type == "levels" ? "" : "/61hertz"}`)
      originalLevels = await req.json()
      cancel()
      document.getElementById("update-text").innerText = "Success!"
      setTimeout(() => {
      document.getElementById("update-text").innerText = ""
      }, 3000)
          }
      deletingLevel = {}
    }
        editingLevel = {}
      }
  </script>
  </head>
  <body class = "" id="wesure">

    <%- include("./navbar.ejs") %>

    <!-- <p><a href = "leaderboard.html">Leaderboard page</a></p>
    <p><a href = "Extendedlist.html">Extended page</a></p> -->
      <br>
      <div class="search-bar" style="display: grid; place-items: center;">
        <h1 style="text-align: center;">Level Editor</h1>
      </div>
      <br>
      <div style="display: grid; place-items: center;">
        <button style="padding: 10px; border-radius: 5px;" onclick="switchLevs()" id="switch">Switch to 61hertz</button>
      </div>
      <br>
      <div style="display: flex; gap: 30px; justify-content: center;">
        <button id="save" style="background-color: blueviolet; color:white; padding: 10px; border-radius: 5px;" onclick="save()" disabled>Save</button>
        <button id="add" style="background-color: blueviolet; color:white; padding: 10px; border-radius: 5px;" onclick="add()">+</button>
        <button id="cancel" onclick="cancel()" style="background-color: red; color:white; padding: 10px; border-radius: 5px;" disabled>Cancel</button>
      </div>
      <br>
      <p style="text-align: center;" id="update-text"></p>
      <br>
    <div id="levels" style="display: flex; flex-wrap: wrap; gap: 10px;"> 
      <% for(let i = 0; i < levels.length; i++) { %>
              <div class="card" style="border: 1px solid black; width:200px" draggable="true" ondragstart="drag(event)" ondragover="allowDrop(event)" ondrop="drop(event)" onclick="popup(<%= i %>)" id="<%= levels[i]._id %>">
                <p><%= levels[i].position %>. <%= levels[i].name %> by <%= levels[i].publisher %></p>
              </div>
          </form>
      <% } %>
         
    </div>
    <!-- scripts to include -->
    <script src="JS/dropdown.js"></script><script src="JS/videoresize.js"></script><script src="JS/darkbutton.js?v=2022-07-30"></script>
  </body>
</html>